APP_ENV=production
PORT=8080
DATABASE_URL=postgres://cbt:CHANGE_ME@db:5432/cbt?sslmode=require
JWT_SECRET=CHANGE_ME_WITH_A_32_CHARACTER_SECRET
CBT_ADMIN_USERNAME=admin
CBT_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
PUBLIC_BASE_URL=https://ujian.pkbmtunasilmu.sch.id
# Isi dengan IP/CIDR proxy Coolify yang benar-benar tersambung langsung ke CBT.
# Jangan gunakan 0.0.0.0/0 atau seluruh jaringan publik; lihat README.
TRUSTED_PROXY_IPS=
# Aktifkan setelah TRUSTED_PROXY_IPS berisi alamat proxy yang sudah diverifikasi.
FORCE_HTTPS=false
LMS_BASE_URL=https://edu.pkbmtunasilmu.sch.id
LMS_PUBLIC_URL=https://edu.pkbmtunasilmu.sch.id
LMS_SSO_HMAC_SECRET=CHANGE_ME_WITH_A_SEPARATE_SHARED_32_CHARACTER_SECRET
LMS_INTEGRATION_KEY_ID=cbt-production
LMS_INTEGRATION_HMAC_SECRET=CHANGE_ME_WITH_A_SHARED_32_CHARACTER_SECRET
LMS_SYNC_INTERVAL=5m
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=16
# Editor kolaboratif baru: aktifkan hanya setelah gerbang staging lulus.
CBT_FORMS_ENABLED=false
CBT_STUDENT_UX_ENABLED=false
# Secret antarlayanan, terpisah dari JWT/SSO/HMAC LMS; minimal 32 karakter.
CBT_COLLABORATION_SECRET=
# WSS publik Node 24. Proxy /realtime ke layanan collaboration:1234,
# atau gunakan wss://kolaborasi.example.sch.id dengan sertifikat TLS.
COLLABORATION_PUBLIC_URL=/realtime
# Embed hanya di origin HTTPS yang dipercaya, kosong berarti dinonaktifkan.
CBT_EMBED_ALLOWED_ORIGINS=
